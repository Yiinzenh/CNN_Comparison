# ===== 数据集 =====
# 约 1.4 GB，含 24000 张图像，体积过大不入库
datasets/

# ===== 训练产物 =====
# 权重、日志、图表均体积大且可由代码重新生成
outputs/

# 模型权重文件（GitHub 单文件上限 100 MB，本项目中最大单个权重 512 MB）
*.pt
*.pth
*.ckpt

# ===== 实验报告 =====
# 报告单独提交，不纳入版本管理
report.txt

# ===== Python 缓存与编译产物 =====
__pycache__/
*.py[cod]
*.so
*.egg-info/
.pytest_cache/

# ===== 虚拟环境 =====
.venv/
venv/
env/

# ===== IDE 配置 =====
.idea/
.vscode/

# ===== 运行日志与临时文件 =====
*.log
*.tmp

# ===== 操作系统临时文件 =====
Thumbs.db
.DS_Store
